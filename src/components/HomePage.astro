---
import { getCollection } from 'astro:content';
import { CATEGORIES, type Category } from '../data/projects';
import type { Lang, UIKey } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import DeliresGate from './DeliresGate.astro';
import Footer from './Footer.astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from './ProjectCard.astro';
import TopBar from './TopBar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const all = await getCollection('projects');
const projects = all
  .map((e) => e.data)
  .sort((a, b) => (b.createdAt ?? '').localeCompare(a.createdAt ?? ''));

const byCategory = (cat: Category) => projects.filter((p) => p.category === cat);
---

<Layout lang={lang}>
  <TopBar lang={lang} />

  <header class="hero wrap">
    <h1 class="logo mono">
      <span class="sigil" aria-hidden="true">$</span>
      {t('site.title')}<span class="caret" aria-hidden="true">_</span>
    </h1>
    <p class="tagline">{t('site.tagline')}</p>
    <p class="intro">{t('site.intro')}</p>
  </header>

  <main id="content" class="wrap" tabindex="-1">
    <div class="toolbar" data-toolbar>
      <label class="search-box">
        <span class="search-prompt mono" aria-hidden="true">/</span>
        <input
          id="project-search"
          type="search"
          class="mono"
          placeholder={`${t('search.placeholder')} (${projects.length} ${t('count.existing')})`}
          autocomplete="off"
          aria-label={t('search.placeholder')}
        />
      </label>
      <div class="sort" role="group" aria-label={t('view.label')}>
        <span class="sort-label mono">
          <span class="label-full">{t('view.label')}</span>
          <span class="label-short">{t('view.label.short')}</span>
        </span>
        <button type="button" class="sort-btn mono" data-view="categories" aria-pressed="true">
          {t('view.categories')}
        </button>
        <button type="button" class="sort-btn mono" data-view="created" aria-pressed="false">
          {t('sort.created')}
        </button>
        <button type="button" class="sort-btn mono" data-view="updated" aria-pressed="false">
          {t('sort.updated')}
        </button>
      </div>
    </div>

    <div id="view-categories">
      {
        CATEGORIES.map((cat) => {
          const items = byCategory(cat);
          if (items.length === 0) return null;
          return (
            <section class="category" data-category={cat} aria-labelledby={`cat-${cat}`}>
              <div class="cat-head">
                <h2 id={`cat-${cat}`} class="cat-title mono">
                  <span class="hash">#</span> {t(`cat.${cat}` as UIKey)}
                  <span class="cat-count" data-total={items.length}>
                    {items.length} {t('count.projects')}
                  </span>
                </h2>
                <p class="cat-desc">{t(`cat.${cat}.desc` as UIKey)}</p>
              </div>
              {cat === 'delires' ? (
                <DeliresGate lang={lang}>
                  {items.map((project) => (
                    <ProjectCard project={project} lang={lang} />
                  ))}
                </DeliresGate>
              ) : (
                <div class="grid" data-grid={cat}>
                  {items.map((project) => (
                    <ProjectCard project={project} lang={lang} />
                  ))}
                </div>
              )}
            </section>
          );
        })
      }
    </div>

    <div id="view-timeline" data-unknown-year={t('year.unknown')} hidden></div>

    <p id="search-empty" class="empty mono" hidden>{t('search.empty')}</p>
  </main>

  <Footer lang={lang} />
</Layout>

<script>
  import '../scripts/home';
</script>

<style>
  .hero {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .logo {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .sigil {
    color: var(--accent);
  }
  .caret {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
    transition: opacity 0.2s ease;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  /* Yield to the real focus indicator: a blinking caret reads as "input
     focus is here", so while anything actually holds focus, settle it to a
     dim steady mark instead of competing with the real cursor / focus ring. */
  :global(body:has(:focus-visible)) .caret {
    animation: none;
    opacity: 0.3;
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--text);
    margin: 0.6rem 0 0.2rem;
  }
  .intro {
    color: var(--text-dim);
    margin: 0;
  }

  .toolbar {
    position: sticky;
    top: var(--topbar-h);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.2rem;
    padding: 0.7rem 0.9rem;
    margin-bottom: 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 240px;
  }
  .search-prompt {
    color: var(--accent);
    font-size: 1rem;
  }
  #project-search {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    color: var(--text);
    font-size: 0.95rem;
    padding: 0.2rem 0;
  }
  #project-search::placeholder {
    color: var(--text-faint);
  }
  #project-search:focus {
    outline: none;
  }
  .search-box:focus-within {
    border-bottom: 1px solid var(--accent-dim);
  }

  .sort {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sort-label {
    color: var(--text-faint);
    font-size: 0.78rem;
    margin-right: 0.1rem;
  }
  .label-short {
    display: none;
  }
  .sort-btn {
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    color: var(--text-dim);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    transition:
      color var(--transition),
      border-color var(--transition),
      background var(--transition);
  }
  .sort-btn:hover {
    color: var(--text);
  }
  .sort-btn[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent-dim);
    background: var(--accent-glow);
  }

  .empty {
    color: var(--text-dim);
    text-align: center;
    padding: 3rem 0;
  }

  .category {
    margin: 3rem 0;
  }
  .cat-head {
    position: sticky;
    top: calc(var(--topbar-h) + var(--toolbar-h));
    z-index: 10;
    margin-bottom: 1.1rem;
    padding: 0.6rem 0 0.5rem 1rem;
    background: var(--bg);
  }
  .cat-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.4rem;
    color: var(--text);
  }
  .category[data-category='jeux'] .hash {
    color: var(--cat-jeux);
  }
  .category[data-category='outils'] .hash {
    color: var(--cat-outils);
  }
  .category[data-category='delires'] .hash {
    color: var(--cat-delires);
  }
  .category[data-category='marmelab'] .hash {
    color: var(--cat-marmelab);
  }
  .cat-count {
    font-size: 0.75rem;
    color: var(--text-faint);
    font-weight: 400;
  }
  .cat-desc {
    color: var(--text-dim);
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 1.75rem;
    }
    .toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.7rem;
    }
    .search-box {
      flex: none;
    }
    .label-full {
      display: none;
    }
    .label-short {
      display: inline;
    }
    .sort {
      flex-wrap: wrap;
    }
    .sort-btn {
      flex: 1 1 auto;
      text-align: center;
    }
    .category {
      margin: 2rem 0;
    }
    .cat-head.stuck .cat-desc {
      display: none;
    }
  }
</style>
